{
  "rewrites": [
    { "source": "/3d/:key", "destination": "/api/view3d?k=:key" },
    { "source": "/d/:key", "destination": "/api/viewdoc?k=:key" }
  ],
  "functions": {
    "api/share3d.js": { "maxDuration": 60 },
    "api/view3d.js": { "maxDuration": 30 },
    "api/doc.js": { "maxDuration": 60 },
    "api/viewdoc.js": { "maxDuration": 30 }
  }
}
