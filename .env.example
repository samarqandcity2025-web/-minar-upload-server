# Set these in the Vercel project (Settings -> Environment Variables).
# Do not commit real values.

# Bot token from @BotFather:
TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token...

# Chat id(s) that receive the files, comma-separated (each person must press
# Start in the bot first). Example: 6156628475,123456789
TELEGRAM_CHAT_ID=6156628475

# Shared key between the Minar app and these functions (also set the same value
# as APP_KEY inside minar-app/minar-upload.js). Any long random string.
MINAR_APP_KEY=change-me-to-a-long-random-string

# BLOB_READ_WRITE_TOKEN is added automatically by Vercel when you create a Blob
# store in the project (Storage -> Create -> Blob). You do not set it by hand.

# Optional: who manages the recipient list in the bot menu (comma-separated).
# Default: the first id in TELEGRAM_CHAT_ID.
# TELEGRAM_ADMIN_ID=6156628475
