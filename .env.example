# Copy to .env (or set these in your hosting dashboard) and fill in real values.
# Never commit real secrets.

# From @BotFather after creating your bot:
TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token...

# Chat/channel id that should receive the files.
# Easiest: start a chat with your bot, send any message, then open
#   https://api.telegram.org/bot<token>/getUpdates  and read chat.id
TELEGRAM_CHAT_ID=123456789

# Any long random string. Used to sign login tokens. Keep it stable and secret.
MINAR_SECRET=change-me-to-a-long-random-string

# Optional:
# PORT=8787
# MINAR_DATA_DIR=./data
# MINAR_MAX_BYTES=62914560
